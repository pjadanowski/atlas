{
    "name": "pjadanowski/atlas",
    "description": "Atlas — fast, static, three-column OpenAPI documentation for Laravel Scramble (and any OpenAPI 3.x spec).",
    "keywords": [
        "laravel",
        "scramble",
        "openapi",
        "swagger",
        "api-documentation",
        "documentation",
        "mcp"
    ],
    "homepage": "https://github.com/pjadanowski/atlas",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Paweł Jadanowski",
            "email": "pjadanowski@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/pjadanowski/atlas/issues",
        "source": "https://github.com/pjadanowski/atlas"
    },
    "require": {
        "php": "^8.2",
        "dedoc/scramble": "^0.13",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Pjadanowski\\Atlas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pjadanowski\\Atlas\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pjadanowski\\Atlas\\AtlasServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
